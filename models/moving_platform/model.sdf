<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.6">
  <model name="moving_platform">
    <static>false</static>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="platform_link">
      <gravity>false</gravity>
      <pose>0 0 2 0 0 0</pose>

      <inertial>
        <mass>10000</mass>
        <inertia>
          <ixx>10000</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>10000</iyy>
          <iyz>0</iyz>
          <izz>10000</izz>
        </inertia>
      </inertial>

      <visual name="platform_visual">
        <geometry>
          <box>
            <size>5 5 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="platform_collision">
        <geometry>
          <box>
            <size>5 5 0.1</size>
          </box>
        </geometry>
      </collision>

      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>

      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <plugin filename="libMovingPlatformController.so" name="moving_platform_controller">
      <axis>x</axis>
      <amplitude>4.0</amplitude>
      <omega>0.25</omega>
      <z_offset>0.0</z_offset>
    </plugin>
  </model>
</sdf>
